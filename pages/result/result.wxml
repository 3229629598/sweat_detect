<!--pages/result/result.wxml-->
<!-- 页面结构 -->
<view class="container">
  <!-- 顶部窄条 -->
  <view class="top-bar">
    <text>Mg²⁺</text>
  </view>
  <!-- 中间图片区 -->
  <view class="middle-section">
    <!-- 左侧两个矩形 -->
    <view class="side-column left">
      <view class="rect">PH</view>
      <view class="rect">Glucose</view>
    </view>
    <!-- 中间正方形图片区 -->
    <view class="center-square">
      <image src="{{src}}" mode="aspectFill" class="center-image" />
    </view>
    <!-- 右侧两个矩形 -->
    <view class="side-column right">
      <view class="rect">Urea</view>
      <view class="rect">
        <text>Cl⁻</text>
      </view>
    </view>
  </view>

  <view class="grid-wrap">
    <view class="grid-row">
      <view class="grid-cell line1">
        <text class="gird-tap-font">Analyte</text>
      </view>
      <view class="grid-cell line2">
        <text class="gird-tap-font">Concentration</text>
      </view>
      <view class="grid-cell line3">
        <text class="gird-tap-font">RGB Values</text>
      </view>
    </view>
    <view class="grid-row">
      <view class="grid-cell line1">
        <text>Mg²⁺</text>
      </view>
      <view class="grid-cell line2">
        <text>{{rx_data[0][3]}}</text>
        <text>mM</text>
      </view>
      <view class="grid-cell line3">
        <view class="gird-tap-font">
          <text>(</text>
          <text style="color: red;">{{rx_data[0][0]}},</text>
          <text style="color: green;">{{rx_data[0][1]}},</text>
          <text style="color: blue;">{{rx_data[0][2]}}</text>
          <text>)</text>
        </view>
      </view>
    </view>
    <view class="grid-row">
      <view class="grid-cell line1">
        <text>PH</text>
      </view>
      <view class="grid-cell line2">
        <text>{{rx_data[1][3]}}</text>
      </view>
      <view class="grid-cell line3">
        <view class="gird-tap-font">
          <text>(</text>
          <text style="color: red;">{{rx_data[1][0]}},</text>
          <text style="color: green;">{{rx_data[1][1]}},</text>
          <text style="color: blue;">{{rx_data[1][2]}}</text>
          <text>)</text>
        </view>
      </view>
    </view>
    <view class="grid-row">
      <view class="grid-cell line1">
        <text>Urea</text>
      </view>
      <view class="grid-cell line2">
        <text>{{rx_data[2][3]}}</text>
        <text>mM</text>
      </view>
      <view class="grid-cell line3">
        <view class="gird-tap-font">
          <text>(</text>
          <text style="color: red;">{{rx_data[2][0]}},</text>
          <text style="color: green;">{{rx_data[2][1]}},</text>
          <text style="color: blue;">{{rx_data[2][2]}}</text>
          <text>)</text>
        </view>
      </view>
    </view>
    <view class="grid-row">
      <view class="grid-cell line1">
        <text>Glucose</text>
      </view>
      <view class="grid-cell line2">
        <text>{{rx_data[3][3]}}</text>
        <text>mM</text>
      </view>
      <view class="grid-cell line3">
        <view class="gird-tap-font">
          <text>(</text>
          <text style="color: red;">{{rx_data[3][0]}},</text>
          <text style="color: green;">{{rx_data[3][1]}},</text>
          <text style="color: blue;">{{rx_data[3][2]}}</text>
          <text>)</text>
        </view>
      </view>
    </view>
    <view class="grid-row">
      <view class="grid-cell line1">
        <text>Cl⁻</text>
      </view>
      <view class="grid-cell line2">
        <text>{{rx_data[4][3]}}</text>
        <text>mM</text>
      </view>
      <view class="grid-cell line3">
        <view class="gird-tap-font">
          <text>(</text>
          <text style="color: red;">{{rx_data[4][0]}},</text>
          <text style="color: green;">{{rx_data[4][1]}},</text>
          <text style="color: blue;">{{rx_data[4][2]}}</text>
          <text>)</text>
        </view>
      </view>
    </view>
  </view>


/**index.wxss**/
.index_flex{
  width: 750rpx;
  margin-top: 30rpx;
  display: flex;
  flex-direction:column;
  justify-content:center;
  align-items: center;
  flex-wrap:nowrap;
  flex-shrink: 0;
}
.index_flex image{
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 30rpx;
  border-radius: 30rpx;
}

.index_flex button{
  margin-bottom: 30rpx;
  background-color:deepskyblue !important;
  font-weight: bold;
  font-size:x-large;
}